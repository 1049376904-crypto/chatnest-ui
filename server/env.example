# ---- 登录 ----
# 应用内密码。前端 POST /api/auth 用它换 token。
CHAT_PASSWORD=change-me
# 签 token 用的随机串，生成：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
CHAT_SECRET=change-this-random-secret

# ---- 模型（OpenAI 兼容中转）----
# 注意结尾不要带 /chat/completions，程序自己拼。
OPENAI_BASE_URL=https://your-relay.example.com/v1
OPENAI_API_KEY=sk-xxxx

# 主聊天模型
CHAT_MODEL=claude-sonnet-4-6
# 思考链摘要 / 工具说明这两条频率高，用便宜的
SUMMARY_MODEL=claude-haiku-4-5

# 一次请求最多回多少 token
MAX_TOKENS=8192
# 带给模型的历史轮数（一问一答算两条）
HISTORY_TURNS=30
# 上游超时秒数，流式回复较慢时往大调
REQUEST_TIMEOUT=300

# 可选：系统提示词。留空则用 server/prompt.txt（若存在）
SYSTEM_PROMPT=

# ---- 时钟 ----
APP_TIMEZONE=Asia/Shanghai
CLOCK_ENABLED=1
CLOCK_GAP_MIN_SEC=300

# ---- 记忆去重门槛 ----
MEMORY_DUP_RATIO=0.82
MEMORY_DUP_JACCARD=0.80
MEMORY_DUP_MIN_CHARS=4

# ---- 数据存放 ----
# 默认为 server/data，会话库、profile、日记、上传都在里面
DATA_DIR=
PORT=8787
