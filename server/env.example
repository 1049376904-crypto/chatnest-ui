# 只有前两项是必填的。其余都能在控制台（/dashboard）里改，
# 这里写的只是默认值——控制台里留空就回退用这边的。

# ---- 登录（必填）----
# 应用内密码。前端和控制台都用它登录。
CHAT_PASSWORD=change-me
# 签 token 用的随机串：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# 改它等于让所有已登录设备下线。
CHAT_SECRET=change-this-random-secret

# ---- 模型接口（可在控制台改）----
# 结尾不要带 /chat/completions，程序自己拼。
OPENAI_BASE_URL=https://your-relay.example.com/v1
OPENAI_API_KEY=sk-xxxx
CHAT_MODEL=claude-sonnet-4-6
# 思考链摘要 / 工具说明这两条频率高，用便宜的
SUMMARY_MODEL=claude-haiku-4-5

MAX_TOKENS=8192
# 带给模型的历史条数（一问一答算两条）
HISTORY_TURNS=30
# 上游超时秒数，工具跑得久时往大调
REQUEST_TIMEOUT=300

# ---- 系统提示词 ----
# ❗ 只能写单行。长提示词请放 server/prompt.txt（本项留空即可）——
# .env 是一行一个 KEY=VALUE，多行文本会从第二行起被静默丢掉。
SYSTEM_PROMPT=

# ---- 时钟 ----
# VPS 在国外的话这一项必改，不然模型会在你的下午说晚安。
APP_TIMEZONE=Asia/Shanghai
CLOCK_ENABLED=1
# 间隔小于这个秒数就不提「距上次说话多久」
CLOCK_GAP_MIN_SEC=300

# ---- 记忆去重门槛 ----
# 调低会误杀新记忆，默认留得偏保守
MEMORY_DUP_RATIO=0.82
MEMORY_DUP_JACCARD=0.80
MEMORY_DUP_MIN_CHARS=4

# ---- 数据存放 ----
# 默认 server/data，会话库、配置、profile、日记、上传都在里面
DATA_DIR=
PORT=8787
